# Copie para .env e ajuste os valores. Nunca commite o .env real.

SECRET_KEY=troque-por-uma-chave-aleatoria-longa
FLASK_DEBUG=0

# --- PostgreSQL ---------------------------------------------------------
# DB_HOST é o nome do serviço/container do Postgres na rede Docker
# (ou o IP/hostname do servidor, se estiver fora do Docker).
DB_HOST=postgres
DB_PORT=5432
DB_NAME=sistema_oc
DB_USER=sistema_oc
DB_PASSWORD=troque-me
# Schema dedicado — criado automaticamente no boot se não existir.
DB_SCHEMA=sistema_oc

# Override opcional: se definido, ignora as variáveis DB_* acima.
# É assim que a suíte de testes aponta para um SQLite temporário.
# DATABASE_URL=postgresql+psycopg://user:senha@host:5432/banco

# --- Primeiro admin -----------------------------------------------------
# Só é usado quando o banco não tem nenhum usuário (primeiro boot).
ADMIN_NOME=Administrador
ADMIN_EMAIL=admin@empresa.com
ADMIN_SENHA=troque-me
ADMIN_AREA=Administrativo
